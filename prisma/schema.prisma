// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====== USERS & AUTHENTICATION ======

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String   @unique
  passwordHash      String?  // Nullable for OAuth-only accounts
  role              UserRole @default(BUYER)

  // Verification status
  verified          Boolean  @default(false)
  whatsappVerified  Boolean  @default(false)
  emailVerified     Boolean  @default(false)

  // OAuth / Social Login
  socialProvider    SocialProvider? // GOOGLE, APPLE, null for email/password
  oauthId           String?  @unique // Provider-specific user ID
  avatar            String?  // Avatar URL from OAuth provider

  // Security & Lockout
  failedLoginAttempts Int    @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean @default(false)

  // Profile data (for both admin & buyer, but mainly buyer)
  profile           UserProfile?

  // Orders & inquiry
  orders            Order[]
  inquiries         Inquiry[]

  // Audit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLoginAt       DateTime?

  @@index([role])
  @@index([verified])
  @@index([socialProvider])
}

enum SocialProvider {
  GOOGLE
  APPLE
}

enum UserRole {
  ADMIN
  BUYER
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal info
  fullName          String
  whatsapp          String   @unique // Format: +62812345678
  businessName      String?
  businessSector    String   // Dropdown list (e.g., "Retail", "Restaurant", "Industrial", etc.)

  // Address
  street            String   // Nama Jalan
  subdistrict       String   // Kelurahan
  district          String   // Kecamatan
  city              String   // Kota/Kabupaten
  province          String   // Provinsi
  country           String   // Negara (ISO2 code e.g., "ID", "SG")
  postalCode        String?

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ====== ORDER & INQUIRY ======

model Order {
  id                String   @id @default(cuid())
  buyerId           String
  buyer             User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  // Order details
  orderNumber       String   @unique
  status            OrderStatus @default(PENDING)

  // Product & configuration
  productCategory   String   // e.g., "Shisha", "BBQ", "Quick Lighting"
  moq               Int      // Minimum Order Quantity (kg)
  packaging         String   // e.g., "Master Box 10 kg"
  deliveryType      String   // "Domestik" atau "Luar Negeri"
  deliveryMethod    String   // e.g., "Indah Kargo", "FOB", "CIF"
  quantity          Int      // Total kg
  subtotal          Decimal  @db.Decimal(12, 2)

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  completedAt       DateTime?

  @@index([buyerId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

model Inquiry {
  id                String   @id @default(cuid())
  buyerId           String
  buyer             User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  // Inquiry details
  inquiryNumber     String   @unique
  message           String   @db.Text
  status            InquiryStatus @default(NEW)

  // Response (admin fills this)
  adminReply        String?  @db.Text
  repliedAt         DateTime?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([buyerId])
  @@index([status])
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  REPLIED
  CLOSED
}

// ====== OTP & VERIFICATION ======

model VerificationToken {
  id                String   @id @default(cuid())
  email             String
  code              String   @unique // 6-digit OTP
  type              VerificationType
  expiresAt         DateTime
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([email, type])
  @@index([email])
  @@index([expiresAt])
}

enum VerificationType {
  EMAIL
  WHATSAPP
}

// ====== AUDIT LOG ======

model AuditLog {
  id                String   @id @default(cuid())
  adminId           String   // User ID who performed action
  action            String   // "CREATE", "UPDATE", "DELETE", "LOGIN", etc.
  entityType        String   // "User", "Order", "Inquiry", etc.
  entityId          String   // ID of entity affected
  changes           Json?    // Before/after snapshot
  ipAddress         String?
  createdAt         DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

// ====== GEOGRAPHIC DATA (PlaceDB) ======

model Country {
  id                String   @id @default(cuid())
  code              String   @unique // ISO 3166-1 alpha-2 (e.g., "ID", "US")
  name              String   @unique
  dial              String?  // International dialing code (e.g., "+62")

  // Relations
  states            State[]
  cities            City[]
  districts         District[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([code])
}

model State {
  id                String   @id @default(cuid())
  code              String   // State/Province code (e.g., "JK", "CA")
  name              String
  countryId         String
  country           Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  // Relations
  cities            City[]
  districts         District[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([countryId, code])
  @@index([countryId])
}

model City {
  id                String   @id @default(cuid())
  name              String
  countryId         String
  country           Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  stateId           String?  // Nullable for countries without states
  state             State?   @relation(fields: [stateId], references: [id], onDelete: Cascade)

  // Relations
  districts         District[]
  postalCodes       PostalCode[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([countryId, stateId, name])
  @@index([countryId])
  @@index([stateId])
}

model District {
  id                String   @id @default(cuid())
  name              String
  countryId         String
  country           Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  stateId           String?
  state             State?   @relation(fields: [stateId], references: [id], onDelete: Cascade)
  cityId            String
  city              City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  // Relations
  postalCodes       PostalCode[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([cityId, name])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
}

model PostalCode {
  id                String   @id @default(cuid())
  code              String
  countryId         String
  country           Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cityId            String?
  city              City?    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  districtId        String?
  district          District? @relation(fields: [districtId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([countryId, code])
  @@index([countryId])
  @@index([cityId])
  @@index([districtId])
}
