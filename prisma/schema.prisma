// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====== USERS & AUTHENTICATION ======

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String   @unique
  passwordHash      String
  role              UserRole @default(BUYER)

  // Verification status
  verified          Boolean  @default(false)
  whatsappVerified  Boolean  @default(false)
  emailVerified     Boolean  @default(false)

  // Profile data (for both admin & buyer, but mainly buyer)
  profile           UserProfile?

  // Orders & inquiry
  orders            Order[]
  inquiries         Inquiry[]

  // Audit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLoginAt       DateTime?

  @@index([role])
  @@index([verified])
}

enum UserRole {
  ADMIN
  BUYER
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal info
  fullName          String
  whatsapp          String   @unique // Format: +62812345678
  businessName      String?
  businessSector    String   // Dropdown list (e.g., "Retail", "Restaurant", "Industrial", etc.)

  // Address
  street            String   // Nama Jalan
  subdistrict       String   // Kelurahan
  district          String   // Kecamatan
  city              String   // Kota/Kabupaten
  province          String   // Provinsi
  country           String   // Negara (ISO2 code e.g., "ID", "SG")
  postalCode        String?

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ====== ORDER & INQUIRY ======

model Order {
  id                String   @id @default(cuid())
  buyerId           String
  buyer             User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  // Order details
  orderNumber       String   @unique
  status            OrderStatus @default(PENDING)

  // Product & configuration
  productCategory   String   // e.g., "Shisha", "BBQ", "Quick Lighting"
  moq               Int      // Minimum Order Quantity (kg)
  packaging         String   // e.g., "Master Box 10 kg"
  deliveryType      String   // "Domestik" atau "Luar Negeri"
  deliveryMethod    String   // e.g., "Indah Kargo", "FOB", "CIF"
  quantity          Int      // Total kg
  subtotal          Decimal  @db.Decimal(12, 2)

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  completedAt       DateTime?

  @@index([buyerId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

model Inquiry {
  id                String   @id @default(cuid())
  buyerId           String
  buyer             User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  // Inquiry details
  inquiryNumber     String   @unique
  message           String   @db.Text
  status            InquiryStatus @default(NEW)

  // Response (admin fills this)
  adminReply        String?  @db.Text
  repliedAt         DateTime?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([buyerId])
  @@index([status])
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  REPLIED
  CLOSED
}

// ====== OTP & VERIFICATION ======

model VerificationToken {
  id                String   @id @default(cuid())
  email             String
  code              String   @unique // 6-digit OTP
  type              VerificationType
  expiresAt         DateTime
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([email, type])
  @@index([email])
  @@index([expiresAt])
}

enum VerificationType {
  EMAIL
  WHATSAPP
}

// ====== AUDIT LOG ======

model AuditLog {
  id                String   @id @default(cuid())
  adminId           String   // User ID who performed action
  action            String   // "CREATE", "UPDATE", "DELETE", "LOGIN", etc.
  entityType        String   // "User", "Order", "Inquiry", etc.
  entityId          String   // ID of entity affected
  changes           Json?    // Before/after snapshot
  ipAddress         String?
  createdAt         DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}
